# TeamWeave MongoDB Configuration
PORT=3000

# MongoDB URI (Uncomment and set your local or MongoDB Atlas connection string)
# If left commented or unavailable, TeamWeave automatically runs with an in-memory MongoDB instance
# MONGODB_URI=mongodb://127.0.0.1:27017/teamweave
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/teamweave?retryWrites=true&w=majority

# ── Python Matchmaking Microservice ────────────────────────────────────────
# When set, ClusteringService.js delegates team formation to the Python
# FastAPI microservice (app.py) which uses a role-stratified round-robin
# + Jaccard-swap algorithm for diverse, cross-functional teams.
# Leave commented out to use the built-in JS K-Means fallback.
#
# Start the microservice first:  python app.py
# Then set:
# PYTHON_MATCHMAKER_URL=http://localhost:8000
